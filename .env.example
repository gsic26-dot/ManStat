# =========================================================================
# MANSTAT MODERN - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# =========================================================================

# Supabase Public API (Accessible by client-side browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Direct Database Connection String (Server-side pooled connection)
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Application Server Port
PORT=3000
